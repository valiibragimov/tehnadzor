{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.d.ts"
  ],
  "exclude": [
    "src/client/app/vendor/**"
  ]
}
