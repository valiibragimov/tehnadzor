rules_version = '2';
service cloud.firestore {
  // Tehnadzor rules keep project data scoped to the authenticated owner.
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isProjectOwner(projectId) {
      let projectPath = /databases/$(database)/documents/projects/$(projectId);
      let project = get(projectPath);
      return signedIn()
        && exists(projectPath)
        && (
          project.data.ownerUid == request.auth.uid ||
          project.data.createdBy == request.auth.uid
        );
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.createdBy == request.auth.uid);
      allow update, delete: if isProjectOwner(projectId);

      function stateRevision() {
        let path = /databases/$(database)/documents/projects/$(projectId)/bimState/current;
        return exists(path) ? get(path).data.get("revision", 0) : 0;
      }
      function catalogAdvanced() {
        return getAfter(/databases/$(database)/documents/projects/$(projectId)/bimState/current).data.revision == stateRevision() + 1;
      }
      function generationAfter(id) {
        return getAfter(/databases/$(database)/documents/projects/$(projectId)/bimGenerations/$(id)).data;
      }
      match /elements/{id} {
        // Legacy BIM is immutable during the generation migration. Admin backfills are explicit.
        allow read: if isProjectOwner(projectId);
      }
      match /bimState/{id} {
        allow read: if isProjectOwner(projectId);
        allow create, update: if isProjectOwner(projectId) && id == "current"
          && request.resource.data.schemaVersion == 1 && catalogAdvanced();
      }
      match /bimGenerations/{id} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId)
          && request.resource.data.keys().hasOnly(["sourceModelId", "status", "updatedAt"])
          && request.resource.data.sourceModelId is string
          && request.resource.data.status == "staging" && request.resource.data.updatedAt == request.time;
        allow update: if isProjectOwner(projectId) && (
          (resource.data.status == "staging" && request.resource.data.updatedAt == request.time
            && request.resource.data.sourceModelId == resource.data.sourceModelId
            && (request.resource.data.status == "staging" ||
              (request.resource.data.status == "ready" && catalogAdvanced()
                && getAfter(/databases/$(database)/documents/projects/$(projectId)/bimModels/$(resource.data.sourceModelId)).data.generation == id)))
          || (resource.data.status == "ready" && request.resource.data.status == "ready"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["retiredAt"])
            && request.resource.data.retiredAt == request.time && catalogAdvanced())
        );
      }
      match /bimElements/{id} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId)
          && generationAfter(request.resource.data.bimGeneration).status == "staging"
          && generationAfter(request.resource.data.bimGeneration).updatedAt == request.time
          && generationAfter(request.resource.data.bimGeneration).sourceModelId == request.resource.data.sourceModelId;
      }
      match /bimModels/{id} {
        allow read: if isProjectOwner(projectId);
        allow create, update: if isProjectOwner(projectId) && catalogAdvanced()
          && request.resource.data.schemaVersion == 1 && request.resource.data.sourceModelId == id
          && (request.resource.data.deleted == true ||
            (generationAfter(request.resource.data.generation).status == "ready"
              && generationAfter(request.resource.data.generation).sourceModelId == id));
      }
      match /bimPublications/{id} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && catalogAdvanced()
          && request.resource.data.generation == id
          && getAfter(/databases/$(database)/documents/projects/$(projectId)/bimModels/$(request.resource.data.sourceModelId)).data == request.resource.data;
      }
      match /bimReaders/{id} {
        allow read, delete: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && catalogAdvanced()
          && request.resource.data.keys().hasOnly(["generations", "updatedAt"])
          && request.resource.data.generations is list && request.resource.data.updatedAt == request.time;
        allow update: if isProjectOwner(projectId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["updatedAt"])
          && request.resource.data.updatedAt == request.time;
      }
      function documentRole() {
        let member = /databases/$(database)/documents/projects/$(projectId)/documentMembers/$(request.auth.uid);
        return signedIn() && exists(member) ? get(member).data.role : "none";
      }
      function documentReader() {
        return signedIn() && (isProjectOwner(projectId) || documentRole() in ["editor", "reader"]);
      }
      function documentEditor() {
        return signedIn() && (isProjectOwner(projectId) || documentRole() == "editor");
      }
      match /documentMembers/{uid} {
        allow read: if signedIn() && (isProjectOwner(projectId) || request.auth.uid == uid);
        allow create, update: if isProjectOwner(projectId)
          && request.resource.data.keys().hasOnly(["role"])
          && request.resource.data.role in ["editor", "reader"];
        allow delete: if isProjectOwner(projectId);
      }
      match /documents/{documentId} {
        allow read: if documentReader();
        allow create: if documentEditor()
          && request.resource.data.keys().hasOnly(["title", "kind", "createdBy", "createdAt"])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.kind in ["aosr", "asBuilt", "certificate", "passport", "laboratory"]
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        match /versions/{versionId} {
          allow read: if documentReader();
          allow create: if documentEditor()
            && existsAfter(/databases/$(database)/documents/projects/$(projectId)/documents/$(documentId))
            && request.resource.data.keys().hasOnly(["title", "kind", "construction", "inspectionCollection", "inspectionId", "bimElementId", "fileName", "size", "sha256", "status", "createdBy", "createdAt", "storagePath"])
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
            && request.resource.data.kind in ["aosr", "asBuilt", "certificate", "passport", "laboratory"]
            && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 256
            && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 20971520
            && request.resource.data.sha256 is string && request.resource.data.sha256.matches('^[0-9a-f]{64}$')
            && request.resource.data.status == "uploading"
            && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
            && request.resource.data.storagePath == "projects/" + projectId + "/documents/" + documentId + "/versions/" + versionId + "/file.pdf"
            && request.resource.data.construction is string && request.resource.data.construction.size() <= 128
            && request.resource.data.bimElementId is string && request.resource.data.bimElementId.size() <= 256
            && ((request.resource.data.inspectionId == "" && request.resource.data.inspectionCollection == "") ||
              (request.resource.data.inspectionId is string && request.resource.data.inspectionId.size() <= 256
                && request.resource.data.inspectionCollection in ["geoNodes", "reinfChecks", "geomChecks", "strengthChecks"]
                && exists(/databases/$(database)/documents/projects/$(projectId)/$(request.resource.data.inspectionCollection)/$(request.resource.data.inspectionId))));
          // Only the API finalizes after checking immutable bytes and rechecking access.
          allow update, delete: if false;
        }
      }
      match /{subCollection}/{docId} {
        allow read, write: if isProjectOwner(projectId)
          && !(subCollection in ["elements", "bimState", "bimGenerations", "bimElements", "bimModels", "bimPublications", "bimReaders", "documents", "documentMembers"]);
      }
    }

    match /journal/{entryId} {
      allow create: if signedIn()
        && request.resource.data.projectId is string
        && isProjectOwner(request.resource.data.projectId);

      allow read, update, delete: if signedIn()
        && resource.data.projectId is string
        && isProjectOwner(resource.data.projectId);
    }
  }
}
