        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "projectId": {
            "type": "string"
          },
          "sourceModelId": {
            "type": [
              "string",
              "null"
            ]
          },
          "deletedCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "ok",
          "projectId",
          "sourceModelId",
          "deletedCount"
        ]
      },
      "ProfileFeedResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "generatedAt": {
            "type": "string"
          },
          "sections": {
            "type": "object",
