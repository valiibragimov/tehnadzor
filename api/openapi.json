                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string"
                    },
                    "categoryLabel": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "sourceLabel": {
                      "type": "string"
                    },
                    "sourceUrl": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "publishedAt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "publishedLabel": {
                      "type": [
                        "string",
                        "null"
                      ]
