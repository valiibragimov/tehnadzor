    "title": "Tehnadzor HTTP API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "ok",
          "error"
        ]
      },
      "ReportRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "construction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "summaryData": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "maxLength": 256
              },
              "construction": {
                "type": "string",
                "maxLength": 64
              },
              "date": {
                "type": "string",
                "maxLength": 32
              },
              "engineer": {
                "type": "string",
                "maxLength": 128
              },
              "geo": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "exceeded": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "total",
                  "exceeded"
                ],
                "additionalProperties": false
              },
              "reinf": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "exceeded": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "total",
                  "exceeded"
                ],
                "additionalProperties": false
              },
              "geom": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "exceeded": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "total",
                  "exceeded"
                ],
                "additionalProperties": false
              },
              "strength": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "exceeded": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "total",
                  "exceeded"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "geo",
              "reinf",
              "geom",
              "strength"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "projectId",
          "summaryData"
        ],
        "additionalProperties": false
      },
      "ReportResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "text"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "status": {
            "type": "string",
            "const": "running"
          },
          "port": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "ok",
          "status",
          "port"
        ]
      },
      "IfcImportResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "projectId": {
            "type": "string"
          },
          "sourceModelId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "importedCount": {
            "type": "integer",
            "minimum": 0
          },
          "replacedCount": {
            "type": "integer",
            "minimum": 0
          },
          "countsByType": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "countsByLabel": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "ok",
          "projectId",
          "sourceModelId",
          "fileName",
          "importedCount",
          "replacedCount",
          "countsByType",
          "countsByLabel"
        ]
      },
